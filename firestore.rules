rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    //  Helper Functions
    // ═══════════════════════════════════════════════════════════════

    /// المستخدم مسجل الدخول
    function isSignedIn() {
      return request.auth != null;
    }

    /// جلب دور المستخدم من Firestore
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /// التحقق من أن المستخدم مدير
    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    /// التحقق من أن المستخدم هو صاحب المستند (uid == userId)
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ═══════════════════════════════════════════════════════════════
    //  1. مجموعة المستخدمين (users)
    // ═══════════════════════════════════════════════════════════════
    match /users/{userId} {
      // ✅ القراءة: مسموح للمستخدمين المسجلين (لجلب وتدقيق بيانات المستلم ورصيده أثناء تحويل الرصيد والعمليات المالية)
      // والـ list مسموح للمسجلين، أو للاستعلام المحدود (limit <= 2) للتحقق الفوري من عدم تكرار رقم الهاتف قبل التسجيل
      allow get: if isSignedIn();
      allow list: if isSignedIn() || (request.query.limit != null && request.query.limit <= 2);

      // ✅ إنشاء حساب جديد: المستخدم ينشئ مستنده الخاص بشرط أن يكون role=='user' والرصيد صفر
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == 'user' &&
        (request.resource.data.balance == 0 || request.resource.data.balance == 0.0)
      );

      // ✅ [CRIT-03 Fixed] التعديل الآمن للرصيد والبيانات:
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.role == resource.data.role &&
        (
          // أ. صاحب الحساب يحدّث بياناته الشخصية بدون تغيير الرصيد أو الدور
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['balance', 'role']) && isOwner(userId)) ||
          // ب. صاحب الحساب يخصم من رصيده فقط (عند شراء كرت أو تحويل رصيد) - يُمنع تزويد رصيده بنفسه
          (isOwner(userId) && request.resource.data.balance < resource.data.balance) ||
          // ج. مستخدم آخر يزيد رصيد هذا الحساب فقط أثناء الحوالة الواردة (يُمنع الخصم وتغيير البيانات)
          (!isOwner(userId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance']) &&
           request.resource.data.balance > resource.data.balance)
        )
      );

      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    //  1.5. سجل أرقام الهواتف الفريدة (phone_registry) - المعيار العالمي
    // ═══════════════════════════════════════════════════════════════
    match /phone_registry/{phone} {
      // ✅ القراءة متاحة للجميع للتحقق الفوري من عدم تكرار الرقم قبل إرسال OTP
      allow read: if true;

      // ✅ الإنشاء مسموح للمستخدم المسجل أثناء إنشاء الحساب وربطه بـ uid الخاص به
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.uid == request.auth.uid
      );

      // التعديل والحذف للمدير أو صاحب الحساب
      allow update, delete: if isAdmin() || (
        isSignedIn() && resource.data.uid == request.auth.uid
      );
    }

    // ═══════════════════════════════════════════════════════════════
    //  2. مخزون الكروت (card_inventory)
    // ═══════════════════════════════════════════════════════════════
    match /card_inventory/{cardId} {
      // ✅ القراءة: أي مستخدم مسجل يمكنه الاستعلام لشراء كرت أو قراءة كروته
      allow read: if isSignedIn();

      // ✅ التعديل عند الشراء: العميل يحول حالة الكرت من available إلى sold لصالحه
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.status == 'available' &&
        request.resource.data.status == 'sold' &&
        request.resource.data.soldToUserId == request.auth.uid
      );

      // الإنشاء والحذف للمدير فقط
      allow create, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    //  3. طلبات الشحن البنكي (deposit_requests)
    // ═══════════════════════════════════════════════════════════════
    match /deposit_requests/{requestId} {
      allow read: if isSignedIn() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount >= 500
        && request.resource.data.amount <= 100000;

      allow update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    //  4. الإشعارات الإدارية (admin_notifications)
    // ═══════════════════════════════════════════════════════════════
    match /admin_notifications/{notifId} {
      // القراءة والتعديل للمدير فقط
      allow read, update, delete: if isAdmin();

      // ✅ السماح للمستخدمين بإرسال إشعارات للمدير (عند الشحن، شراء كرت، تحويل)
      // + السماح بإرسال إشعار طلب تسجيل حساب جديد حتى لو لم يكن العميل مسجلاً
      allow create: if isSignedIn() || request.resource.data.type == 'registration_new';
    }

    // ═══════════════════════════════════════════════════════════════
    //  4.5. إشعارات العميل الموجهة (user_notifications)
    // ═══════════════════════════════════════════════════════════════
    match /user_notifications/{notifId} {
      // العميل يرى إشعاراته الخاصة فقط — والمدير يرى الكل
      allow read: if isSignedIn() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );

      // السماح بإنشاء الإشعارات الموجهة للعملاء (عند الموافقة/الرفض)
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
    }

    // ═══════════════════════════════════════════════════════════════
    //  5. سجل المعاملات (transactions_log)
    // ═══════════════════════════════════════════════════════════════
    match /transactions_log/{logId} {
      allow read: if isSignedIn() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );

      // ✅ تسجيل السجلات عند عمليات الشراء والتحويل
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.type == 'transfer_received'
      );

      allow update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    //  6. الحسابات البنكية (network_bank_accounts)
    // ═══════════════════════════════════════════════════════════════
    match /network_bank_accounts/{accountId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    //  7. الباقات المتاحة (packages)
    // ═══════════════════════════════════════════════════════════════
    match /packages/{packageId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    //  8. إعدادات التطبيق (app_config) — إصدار التحديث الإلزامي وتوكنات المديرين
    // ═══════════════════════════════════════════════════════════════
    match /app_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════
    //  9. طلبات إنشاء الحسابات (registration_requests)
    // ═══════════════════════════════════════════════════════════════
    match /registration_requests/{requestId} {
      // السماح بإنشاء أو تحديث طلب التسجيل مع تحقق صارم من البيانات
      allow create, update: if isAdmin() || (
        request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.email is string
        && (!('verificationCode' in request.resource.data) || request.resource.data.verificationCode is string)
        && (
          // طلب جديد
          request.resource.data.status == 'pending' ||
          // تسجيل محاولة خاطئة للكود
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['failedAttempts']) ||
          // إكمال الطلب بعد إنشاء الحساب
          (isSignedIn() && request.resource.data.status == 'completed')
        )
      );

      // قراءة الطلب الخاص (get) متاحة للعميل لمتابعة حالة طلبه
      allow get: if true;
      // قائمة كل الطلبات (list) للمدير، أو للاستعلام المحدود (limit <= 2) للتحقق من عدم تكرار الطلب
      allow list: if isAdmin() || (request.query.limit != null && request.query.limit <= 2);

      // الحذف للمدير، أو للعميل عند إلغاء طلبه الخاص بالرقم المطابق
      allow delete: if isAdmin() || (
        resource.data.status in ['pending', 'approved'] &&
        (requestId == resource.data.phone || requestId == '967' + resource.data.phone)
      );
    }

    // ═══════════════════════════════════════════════════════════════
    //  10. قفل عام — رفض أي طلب غير مذكور
    // ═══════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
